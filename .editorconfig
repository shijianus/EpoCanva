root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.cc]
indent_size = 2
continuation_indent_size = 4

[*.h]
indent_size = 2
continuation_indent_size = 4

[*.{md,mdx}]
trim_trailing_whitespace = false
max_line_length = off

[CMakeLists.txt]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab
