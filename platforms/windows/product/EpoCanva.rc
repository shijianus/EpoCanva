#include <windows.h>

// W3-B: the internal version is 0.2.6-w3b (platforms/windows/product/VERSION). The numeric
// fields can carry no suffix; they are the 0.2.6 prefix of that version. The suffix is
// recorded in VERSION.txt, --diagnose and the About box only.
1 ICON "EpoCanva.ico"

1 VERSIONINFO
FILEVERSION 0,2,6,0
PRODUCTVERSION 0,2,6,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "EpoCanva English Alpha settings (internal alpha)"
      VALUE "FileVersion", "0.2.6.0"
      VALUE "InternalName", "EpoCanva"
      VALUE "OriginalFilename", "EpoCanva.exe"
      VALUE "ProductName", "EpoCanva English Alpha"
      VALUE "ProductVersion", "0.2.6.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
