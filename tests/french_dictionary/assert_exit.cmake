if(NOT DEFINED PROBE OR NOT DEFINED MODE OR NOT DEFINED EXPECTED_EXIT)
  message(FATAL_ERROR "Missing exact-exit test arguments")
endif()
execute_process(COMMAND "${PROBE}" "${MODE}"
  RESULT_VARIABLE actual_exit OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${actual_exit}" STREQUAL "${EXPECTED_EXIT}")
  message(FATAL_ERROR "Headless test ${MODE} exit was ${actual_exit}, expected ${EXPECTED_EXIT}; output suppressed to avoid echoing content")
endif()
if(EXPECTED_EXIT EQUAL 0)
  string(REPLACE "\r\n" "\n" normalized_output "${output}")
  if(NOT normalized_output STREQUAL "RESULT PASS\n")
    message(FATAL_ERROR "Successful headless test ${MODE} emitted unexpected stdout; output suppressed")
  endif()
endif()
if(EXPECTED_EXIT EQUAL 1 AND NOT output MATCHES "RESULT FAIL")
  message(FATAL_ERROR "Failure control did not execute an assertion")
endif()
if(EXPECTED_EXIT EQUAL 2 AND NOT output MATCHES "INVALID MODE")
  message(FATAL_ERROR "Unknown mode was not rejected")
endif()
if(NOT error STREQUAL "")
  message(FATAL_ERROR "Headless test ${MODE} emitted unexpected stderr; output suppressed")
endif()
message(STATUS "Exact exit ${actual_exit} observed")
