if(NOT DEFINED PROBE OR NOT DEFINED MODE OR NOT DEFINED EXPECTED_EXIT)
  message(FATAL_ERROR "Missing negative-control arguments")
endif()
execute_process(COMMAND "${PROBE}" "${MODE}"
  RESULT_VARIABLE actual_exit OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT "${actual_exit}" STREQUAL "${EXPECTED_EXIT}")
  message(FATAL_ERROR "Expected ${EXPECTED_EXIT}, got ${actual_exit}; ${output}; ${error}")
endif()
if("${output}" MATCHES "RESULT PASS")
  message(FATAL_ERROR "Negative control printed a false success marker")
endif()
if("${MODE}" STREQUAL "--force-failure" AND NOT "${error}" MATCHES "intentional assertion")
  message(FATAL_ERROR "Negative control did not execute the failing assertion")
endif()
message(STATUS "Negative control observed exact exit ${actual_exit}")
