+// Deterministic work-unit budget. Every clock query advances one unit for
+// the current thread, so identical input truncates at the identical operation
+// count regardless of scheduler or I/O load. The constants are operation
+// counts, not wall-clock milliseconds: the previous budgets were wall time.
+// The ceilings are far above the maximum work reachable for MAXWORDLEN input,
+// so an accepted query publishes a complete result instead of a partial set
+// truncated wherever the scheduler happened to preempt it.
+namespace epocanva_det_clock {
+inline thread_local long long ticks = 0;
+inline std::chrono::steady_clock::time_point now() {
+  return std::chrono::steady_clock::time_point(
+      std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+          std::chrono::milliseconds(++ticks)));
+}
+inline void reset() { ticks = 0; }
+}  // namespace epocanva_det_clock
+#define TIMELIMIT_GLOBAL_MS std::chrono::milliseconds(20000000)
+#define TIMELIMIT_SUGGESTION_MS std::chrono::milliseconds(8000000)
+#define TIMELIMIT_MS std::chrono::milliseconds(4000000)
 #define MINTIMER 100
